# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, add every one of these under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
# (Not a secret, but it is only ever read server-side in this app.)
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_.
# It bypasses Row Level Security and can read/write every table.
SUPABASE_SERVICE_ROLE_KEY=


# --- App access ------------------------------------------------------------
# Shared password that staff type once on the scanner and admin pages.
# Without this, anyone who finds your Vercel URL can mark attendees present
# and blast your whole attendee list with emails. Set it to something long.
# If unset, the app allows access in local dev and REFUSES it in production.
APP_PASSWORD=


# --- Manual ticket fallback -------------------------------------------------
# Signs the shareable ticket link (used when a ticket email fails or never
# arrives) so it can't be forged by guessing attendee IDs. Generate one with:
#   openssl rand -hex 32
TICKET_LINK_SECRET=


# --- Email -----------------------------------------------------------------
# Which transactional provider to use: resend | brevo | smtp
EMAIL_PROVIDER=resend

# Provider API key (Resend: re_xxx / Brevo: your SMTP key).
EMAIL_API_KEY=

# Brevo only: the SMTP login it gives you (looks like 8xxxxx@smtp-brevo.com).
# Leave blank for Resend, which always uses the literal login "resend".
EMAIL_SMTP_USER=

# EMAIL_PROVIDER=smtp only: point at any other SMTP host.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=

# The From address. The domain here must be verified with your provider
# (SPF + DKIM + DMARC DNS records) or your mail lands in spam.
EMAIL_FROM=sustainabilitysphere@giisclubs.org

# Optional display name shown in the recipient's inbox.
EMAIL_FROM_NAME=Sustainability Sphere


# --- Event details (used in the ticket email copy) -------------------------
EVENT_NAME=Sustainability Sphere
EVENT_DATE=
EVENT_LOCATION=
